# ==================================================
# MARINEX AI - Environment Configuration Template
# Problem Statement: ORCA — Marine EcOsystem Reasoning with Collaborative Agents
# Phase 4: Real Marine Data Integration + Geo-spatial Intelligence
# ==================================================
# DO NOT commit actual secrets or credentials to source control.

# --- Backend Configuration ---
ENVIRONMENT=development
PORT=8000
IS_DEMO=true
MARINEX_DEMO_MODE=false

# --- RAG & Vector Database (Phase 2) ---
VECTOR_DB_PATH=./storage/chroma
DOCUMENTS_DIR=../data/documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
EMBEDDING_PROVIDER=auto
LLM_PROVIDER=auto

# --- Database & Spatial Backend (Phase 4/5) ---
# Set to configure real PostgreSQL / PostGIS database (optional)
DATABASE_URL=postgresql://marinex_user:marinex_password@localhost:5432/marinex_db

# --- LLM Providers & Agent Orchestration (Phase 2 & Phase 3) ---
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
LANGGRAPH_ENABLED=true
AGENT_TRACE_ENABLED=true
MAX_AGENT_STEPS=10

# --- Marine Data Gateway & Caching (Phase 4) ---
WEATHER_CACHE_TTL=600       # 10 minutes cache for weather
OCEAN_CACHE_TTL=1800        # 30 minutes cache for ocean
PFZ_CACHE_TTL=3600          # 1 hour cache for PFZ advisories
GEOSPATIAL_CACHE_TTL=86400  # 24 hours cache for static geospatial layers

# --- External Marine & Remote Sensing Data Providers (Phase 4) ---
# Weather & Ocean: Open-Meteo APIs are key-free and work out-of-the-box.
# Satellite EO: ISRO MOSDAC (optional - reports "not_configured" if omitted)
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# Government Marine Advisories (optional)
INCOIS_API_KEY=your_incois_api_key
IMD_API_KEY=your_imd_api_key
GOOGLE_MAPS_API_KEY=AIzaSyCyVgdCtTeDI9yt98juj38DAONK_ohgSDE

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_DEMO_MODE=false
