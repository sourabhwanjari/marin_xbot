# ==============================================================================
# MARINEX AI — Environment Configuration Template (.env.example)
# PHASE 5A: Marine Data Foundation + Marine Data Gateway
# ==============================================================================

# --- Application Configuration ---
APP_NAME=MARINEX AI
APP_ENV=development
API_PORT=8000
IS_DEMO=true
MARINEX_DEMO_MODE=true

# --- LLM Providers ---
# Google Gemini API Key for multi-agent reasoning & conversational chatbot
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# --- IMD (India Meteorological Department) ---
IMD_ENABLED=false
IMD_API_KEY=
IMD_BASE_URL=

# --- INCOIS (Indian National Centre for Ocean Information Services) ---
INCOIS_ENABLED=false
INCOIS_API_KEY=
INCOIS_BASE_URL=

# --- ISRO MOSDAC (Satellite Earth Observation) ---
MOSDAC_ENABLED=false
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_DATASET_ID=
MOSDAC_BASE_URL=

# --- PostgreSQL & PostGIS (Maritime Geospatial Engine) ---
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGIS_ENABLED=false

# --- Vector Store / RAG ---
CHROMA_PERSIST_DIRECTORY=./storage/chroma
EMBEDDING_PROVIDER=deterministic-local
